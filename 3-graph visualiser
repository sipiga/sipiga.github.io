  $("unpin").addEventListener("click", () => { scene.pinned.clear(); scene.render(); });
  $("style").addEventListener("change", ev => { single.style = scene.opt.style = ev.target.value; scene.render(); });
  $("fill").addEventListener("input", ev => { single.fill = scene.opt.fill = parseFloat(ev.target.value); scene.render(); });
  $("halo").addEventListener("input", ev => { single.halo = scene.opt.halo = parseFloat(ev.target.value); scene.render(); });
  $("scale").addEventListener("input", ev => {
    const s = parseFloat(ev.target.value), k = s / single.scale;
    for (const v of scene.V) { v.x = clamp(W / 2 + (v.x - W / 2) * k, PAD, W - PAD); v.y = clamp(H / 2 + (v.y - H / 2) * k, PAD, H - PAD); }
    single.scale = s; scene.render();
  });
  $("labels").addEventListener("change", ev => { single.labels = scene.opt.labels = ev.target.checked; scene.render(); });
  $("ghost").addEventListener("change", ev => { single.ghost = ev.target.checked; scene.render(); });
  $("showAxes").addEventListener("change", ev => { single.axes = ev.target.checked; scene.render(); });

  /* ================= View 2: cross products H × F ================= */
  const idOf = id => DATA.findIndex(g => g.id === id);
  const product = {
    h: idOf("P5"), f: FLIST.indexOf(idOf("P3K2")), hl: 0, fl: 0,
    selH: new Set(), selF: new Set(), hovH: null, hovF: null,
    nest: "H", colour: "auto", fillK: 1, lineK: 1, size: 1, cluster: 1, labels: true, background: true,
    fibers: [], shown: 0
  };
  const pH = () => DATA[product.h], pF = () => DATA[FLIST[product.f]];
  const facName = w => (w === "H" ? pH() : pF());
  const facSel = w => (w === "H" ? product.selH : product.selF);
  const facLayout = w => facName(w).layouts[w === "H" ? product.hl : product.fl];
  const vLabel = (w, i) => (w === "H" ? String(i + 1) : LETTERS[i]);
  const eLabel = (w, e) => e.map(v => vLabel(w, v - 1)).join("");

  function colourMode() {
    if (product.colour !== "auto") return product.colour;
    const blocks = (product.selH.size || pH().edges.length) * (product.selF.size || pF().edges.length);
    return blocks === 1 ? "match" : product.nest;
  }

  function productContent() {
    const G = pH(), F = pF(), nG = G.n, nF = F.n, nest = product.nest;
    const outer = nest === "H" ? G : F, inner = nest === "H" ? F : G;
    const LO = facLayout(nest), LI = facLayout(nest === "H" ? "F" : "H");
    const nO = outer.n, nI = inner.n;
    const idx = (g, h) => g * nF + h;                       // g: vertex of H, h: vertex of F (0-based)
    const at = (o, i) => (nest === "H" ? idx(o, i) : idx(i, o));   // o: outer vertex, i: inner vertex
    let dmin = Infinity;
    for (let a = 0; a < nO; a++) for (let b = a + 1; b < nO; b++) dmin = Math.min(dmin, Math.hypot(LO.pos[a][0] - LO.pos[b][0], LO.pos[a][1] - LO.pos[b][1]));
    const rho = Math.min(0.34, 0.43 * dmin) * product.cluster;
    const unit = new Array(nG * nF); let ext = 0;
    for (let o = 0; o < nO; o++) for (let i = 0; i < nI; i++) {
      const x = LO.pos[o][0] + rho * LI.pos[i][0], y = LO.pos[o][1] + rho * LI.pos[i][1];
      unit[at(o, i)] = [x, y]; ext = Math.max(ext, Math.abs(x), Math.abs(y));
    }
    const s = (W / 2 - 48) / ext * product.size;
    const V = unit.map((p, j) => {
      const g = Math.floor(j / nF), h = j % nF;
      return { label: (g + 1) + LETTERS[h], g, h, x: W / 2 + s * p[0], y: H / 2 + s * p[1] };
    });
    const E = [];
    G.edges.forEach((e, ei) => F.edges.forEach((f, fi) => PERMS.forEach((p, pi) => {
      E.push({ v: [0, 1, 2].map(j => idx(e[j] - 1, f[p[j]] - 1)), ei, fi, pi, color: NEUTRAL, visible: true });
    })));

    let layerRef = null, discEls = [], bandEls = [], innerEls = [];
    const painter = {
      build(layer) {
        layerRef = layer;
        bandEls = outer.edges.map(() => { const p = el("polygon", { class: "band" }); layer.appendChild(p); return p; });
        discEls = range(nO).map(() => { const c = el("circle", { class: "disc" }); layer.appendChild(c); return c; });
        innerEls = [];
        for (let o = 0; o < nO; o++) inner.edges.forEach((f, fi) => {
          const p = el("polygon", { class: "inner" }); layer.appendChild(p); innerEls.push({ o, fi, f, p });
        });
      },
      update(sc) {
        layerRef.style.display = product.background ? "" : "none";
        const fib = range(nO).map(o => {
          let x = 0, y = 0;
          for (let i = 0; i < nI; i++) { const v = sc.V[at(o, i)]; x += v.x; y += v.y; }
          x /= nI; y /= nI;
          let r = 0;
          for (let i = 0; i < nI; i++) { const v = sc.V[at(o, i)]; r = Math.max(r, Math.hypot(v.x - x, v.y - y)); }
          return { x, y, r: r + 17 };
        });
        product.fibers = fib;
        if (!product.background) return;
        const mode = colourMode(), inName = nest === "H" ? "F" : "H";
        const emph = w => {
          const hov = w === "H" ? product.hovH : product.hovF, sel = facSel(w);
          return hov !== null ? new Set([hov]) : (sel.size ? sel : null);
        };
        const eo = emph(nest), ei = emph(inName);
        discEls.forEach((c, o) => { c.setAttribute("cx", fib[o].x); c.setAttribute("cy", fib[o].y); c.setAttribute("r", fib[o].r); });
        bandEls.forEach((p, k) => {
          p.setAttribute("points", outer.edges[k].map(v => fib[v - 1].x + "," + fib[v - 1].y).join(" "));
          p.style.setProperty("--c", mode === nest ? PALETTE[k % PALETTE.length] : NEUTRAL);
          p.classList.toggle("sel", !!(eo && eo.has(k)));
          p.classList.toggle("unsel", !!(eo && !eo.has(k)));
        });
        innerEls.forEach(it => {
          it.p.setAttribute("points", it.f.map(v => { const q = sc.V[at(it.o, v - 1)]; return q.x + "," + q.y; }).join(" "));
          it.p.style.setProperty("--c", mode === inName ? PALETTE[it.fi % PALETTE.length] : NEUTRAL);
          it.p.classList.toggle("sel", !!(ei && ei.has(it.fi)));
          it.p.classList.toggle("unsel", !!(ei && !ei.has(it.fi)));
        });
      }
    };
    const handles = range(nO).map(o => ({
      label: vLabel(nest, o),
      title: "Drag to move the whole cluster of vertex " + vLabel(nest, o) + " of " + nest,
      members: range(nI).map(i => at(o, i)),
      anchor: () => {
        const fb = product.fibers[o];
        let dx = fb.x - W / 2, dy = fb.y - H / 2;
        const d = Math.hypot(dx, dy);
        if (d < 20) { dx = -0.7071; dy = -0.7071; } else { dx /= d; dy /= d; }
        return { x: clamp(fb.x + dx * (fb.r + 14), 13, W - 13), y: clamp(fb.y + dy * (fb.r + 14), 12, H - 12) };
      }
    }));
    scene.moveSet = (j, ev) => {
      const v = V[j];
      const sameOuter = u => (nest === "H" ? u.g === v.g : u.h === v.h), sameInner = u => (nest === "H" ? u.h === v.h : u.g === v.g);
      if (ev.shiftKey) return range(V.length).filter(u => sameOuter(V[u]));
      if (ev.altKey) return range(V.length).filter(u => sameInner(V[u]));
      return [j];
    };
    chipMap = [];
    scene.opt = { fill: 0.05, halo: 2, style: "blob", labels: product.labels };
    scene.setContent(V, E, { r: 10.5, font: 10.5, hubs: false, painter, handles });
  }

  // apply the edge filter, colours and line weights to the current product
  function productRefresh() {
    const E = scene.E, G = pH(), F = pF();
    let n = 0;
    for (const e of E) {
      e.visible = (!product.selH.size || product.selH.has(e.ei)) && (!product.selF.size || product.selF.has(e.fi));
      if (e.visible) n++;
    }
    product.shown = n;
    const mode = colourMode();
    for (const e of E) {
      const c = mode === "H" ? PALETTE[e.ei % PALETTE.length] : mode === "F" ? PALETTE[e.fi % PALETTE.length] : PALETTE[e.pi];
      if (c !== e.color) { e.color = c; e.grp.style.setProperty("--c", c); }
    }
    const tier = n <= 6 ? [0.2, 6, 0.75] : n <= 24 ? [0.1, 3.4, 0.6] : n <= 72 ? [0.045, 2.2, 0.5] : [0.022, 1.5, 0.42];
    const halo = tier[1] * product.lineK;
    scene.opt = { fill: Math.min(0.6, tier[0] * product.fillK), halo, haloHot: Math.max(halo, 4.5), so: tier[2], soDim: 0.07, style: "blob", labels: product.labels, minBar: Math.max(2, halo) };
    scene.pinned.forEach(k => { if (!E[k].visible) scene.pinned.delete(k); });

    // chips for the product edges, when few enough are shown to list
    chipMap = []; $("edgeList").innerHTML = "";
    $("edgesTitle").textContent = "Edges shown";
    if (n <= 36) {
      $("edgeNote").textContent = "";
      E.forEach((e, k) => {
        if (!e.visible) return;
        const vs = e.v.map(j => scene.V[j]).sort((a, b) => a.g - b.g);
        edgeChip(k, vs.map(v => v.label).join(" "), "Edge {" + vs.map(v => "(" + (v.g + 1) + ", " + LETTERS[v.h] + ")").join(", ") + "}", e.color);
      });
    } else {
      $("edgeNote").textContent = n + " edges are shown. Choose an edge of H and an edge of F to list the six product edges between them.";
    }

    // info
    $("facts").innerHTML = "";
    $("desc").textContent = "Vertices are pairs: a vertex of H followed by a vertex of F, written as a number and a letter. Three of them form an edge when the numbers form an edge of H and the letters form an edge of F.";
    addFact("Size", (G.n * F.n) + " vertices, " + E.length + " edges: six for each of the " + G.edges.length + " × " + F.edges.length + " pairs of edges.");
    const part = (w, g) => { const s = facSel(w); return s.size ? Array.from(s).sort((a, b) => a - b).map(k => eLabel(w, g.edges[k])).join(", ") : "all"; };
    addFact("Showing", n === E.length ? "All " + n + " edges." : n + " of " + E.length + " edges. Edges of H: " + part("H", G) + ". Edges of F: " + part("F", F) + ".");
    let sub = "Contains F₅, so it is not tripartite. ";
    if (G.k4m && F.k4m) sub += "Contains K₄⁻ as well.";
    else sub += "Contains no K₄⁻, because " + [G, F].filter(x => !x.k4m).map(x => x.name).filter((x, i, a) => a.indexOf(x) === i).join(" and ") + " contains none.";
    addFact("Subgraphs", sub);

    paintFactor("H"); paintFactor("F");
    scene.orderKey = "";
    scene.render();
  }

  /* factor panels */
  const fac = { H: { edges: [], chips: [] }, F: { edges: [], chips: [] } };
  function buildFactor(w) {
    const g = facName(w), L = facLayout(w), S = 100;
    const svg = $("fac" + w + "_mini"), ul = $("fac" + w + "_chips");
    svg.innerHTML = ""; ul.innerHTML = "";
    fac[w].edges = []; fac[w].chips = [];
    const preview = k => {
      if (w === "H") product.hovH = k; else product.hovF = k;
      scene.ext = k === null ? null : { edge: e => (w === "H" ? e.ei : e.fi) === k };
      paintFactor(w); scene.render();
    };
    const toggle = k => {
      const s = facSel(w);
      if (s.has(k)) s.delete(k); else s.add(k);
      productRefresh();
    };
    const bars = [];
    g.edges.forEach((e, k) => {
      const pts = e.map(v => L.pos[v - 1]);
      const a = Math.abs((pts[1][0] - pts[0][0]) * (pts[2][1] - pts[0][1]) - (pts[1][1] - pts[0][1]) * (pts[2][0] - pts[0][0]));
      const p = el("polygon", { class: "medge" + (a < 0.01 ? " bar" : ""), points: pts.map(q => (q[0] * S) + "," + (q[1] * S)).join(" ") });
      p.style.setProperty("--c", PALETTE[k % PALETTE.length]);
      p.addEventListener("pointerenter", () => preview(k));
      p.addEventListener("pointerleave", () => preview(null));
      p.addEventListener("click", () => toggle(k));
      if (a < 0.01) bars.push(p); else svg.appendChild(p);
      fac[w].edges.push(p);

      const li = document.createElement("li");
      li.style.setProperty("--c", PALETTE[k % PALETTE.length]);
      const sw = document.createElement("span"); sw.className = "sw";
      li.appendChild(sw); li.appendChild(document.createTextNode(eLabel(w, e)));
      li.title = "Show only the product edges over this edge of " + w;
      li.addEventListener("mouseenter", () => preview(k));
      li.addEventListener("mouseleave", () => preview(null));
      li.addEventListener("click", () => toggle(k));
      ul.appendChild(li);
      fac[w].chips.push(li);
    });
    bars.forEach(p => svg.appendChild(p));
    L.pos.forEach((q, i) => {
      const grp = el("g", { class: "mv", transform: "translate(" + (q[0] * S) + "," + (q[1] * S) + ")" });
      grp.appendChild(el("circle", { r: 15 }));
      const t = el("text", { "text-anchor": "middle", "dominant-baseline": "central" });
      t.textContent = vLabel(w, i); grp.appendChild(t);
      const tt = el("title"); tt.textContent = "Vertex " + vLabel(w, i) + " of " + w; grp.appendChild(tt);
      grp.addEventListener("pointerenter", () => {
        const has = v => (w === "H" ? v.g : v.h) === i;
        scene.ext = { edge: e => e.v.some(j => has(scene.V[j])), vertex: has };
        scene.render();
      });
      grp.addEventListener("pointerleave", () => { scene.ext = null; scene.render(); });
      svg.appendChild(grp);
    });
    const ls = $("fac" + w + "_layout"); ls.innerHTML = "";
    g.layouts.forEach((Lx, i) => {
      const o = document.createElement("option"); o.value = i; o.textContent = "Layout: " + Lx.name.toLowerCase(); ls.appendChild(o);
    });
    ls.value = w === "H" ? product.hl : product.fl;
    ls.style.display = g.layouts.length < 2 ? "none" : "";
    $("fac" + w + "_sel").value = w === "H" ? product.h : product.f;
  }
  function paintFactor(w) {
    const sel = facSel(w), hov = w === "H" ? product.hovH : product.hovF;
    fac[w].edges.forEach((p, k) => {
      const on = sel.has(k) || hov === k, any = sel.size > 0 || hov !== null;
      p.classList.toggle("sel", any && on);
      p.classList.toggle("unsel", any && !on);
    });
    fac[w].chips.forEach((li, k) => {
      li.classList.toggle("pinned", sel.has(k));
      li.classList.toggle("hot", hov === k && !sel.has(k));
      li.classList.toggle("dim", sel.size > 0 && !sel.has(k) && hov !== k);
    });
    $("fac" + w + "_note").textContent = sel.size
      ? "Showing the product edges over " + (sel.size === 1 ? "this edge" : "these " + sel.size + " edges") + " of " + w + "."
      : "All edges of " + w + " are in use. Click one to isolate it.";
  }
  function showProduct(keepSelection) {
    if (!keepSelection) { product.selH.clear(); product.selF.clear(); }
    product.hovH = product.hovF = null;
    $("title").innerHTML = fmt(pH().name) + " × " + fmt(pF().name);
    buildFactor("H"); buildFactor("F");
    productContent();
    productRefresh();
  }
  function fillFactorSelects() {
    const mk = (sel, list) => {
      const groups = {};
      list.forEach((di, j) => {
        const g = DATA[di], key = g.edges.length + " edges";
        if (!groups[key]) { groups[key] = document.createElement("optgroup"); groups[key].label = key; sel.appendChild(groups[key]); }
        const o = document.createElement("option"); o.value = j; o.textContent = g.name + (g.n === 4 ? " (4 vertices)" : "");
        groups[key].appendChild(o);
      });
    };
    mk($("facH_sel"), DATA.map((g, i) => i));
    mk($("facF_sel"), FLIST);
  }
  $("facH_sel").addEventListener("change", ev => { product.h = Number(ev.target.value); product.hl = 0; showProduct(false); });
  $("facF_sel").addEventListener("change", ev => { product.f = Number(ev.target.value); product.fl = 0; showProduct(false); });
  $("facH_prev").addEventListener("click", () => { product.h = (product.h - 1 + DATA.length) % DATA.length; product.hl = 0; showProduct(false); });
  $("facH_next").addEventListener("click", () => { product.h = (product.h + 1) % DATA.length; product.hl = 0; showProduct(false); });
  $("facF_prev").addEventListener("click", () => { product.f = (product.f - 1 + FLIST.length) % FLIST.length; product.fl = 0; showProduct(false); });
  $("facF_next").addEventListener("click", () => { product.f = (product.f + 1) % FLIST.length; product.fl = 0; showProduct(false); });
  $("facH_layout").addEventListener("change", ev => { product.hl = Number(ev.target.value); showProduct(true); });
  $("facF_layout").addEventListener("change", ev => { product.fl = Number(ev.target.value); showProduct(true); });
  $("pNest").addEventListener("change", ev => { product.nest = ev.target.value; showProduct(true); });
  $("pColour").addEventListener("change", ev => { product.colour = ev.target.value; productRefresh(); });
  $("pFill").addEventListener("input", ev => { product.fillK = parseFloat(ev.target.value); productRefresh(); });
  $("pLine").addEventListener("input", ev => { product.lineK = parseFloat(ev.target.value); productRefresh(); });
  $("pSize").addEventListener("input", ev => { product.size = parseFloat(ev.target.value); showProduct(true); });
  $("pCluster").addEventListener("input", ev => { product.cluster = parseFloat(ev.target.value); showProduct(true); });
  $("pLabels").addEventListener("change", ev => { product.labels = scene.opt.labels = ev.target.checked; scene.render(); });
  $("pBack").addEventListener("change", ev => { product.background = ev.target.checked; scene.render(); });
  $("pReset").addEventListener("click", () => showProduct(true));
  $("pUnpin").addEventListener("click", () => { scene.pinned.clear(); scene.render(); });
  $("pAll").addEventListener("click", () => { product.selH.clear(); product.selF.clear(); productRefresh(); });

  /* ================= switching between the two views ================= */
  let mode = null;
  function setMode(m, fromHash) {
    if (m === mode) return;
    mode = m;
    document.body.dataset.mode = m;
    $("tabSingle").setAttribute("aria-selected", String(m === "single"));
    $("tabProduct").setAttribute("aria-selected", String(m === "product"));
    if (m === "single") showSingle(); else showProduct(true);
    if (!fromHash) { try { location.hash = m === "single" ? "single" : "products"; } catch (e) { /* the view still switches */ } }
  }
  const modeOfHash = () => (location.hash === "#products" ? "product" : "single");
  $("tabSingle").addEventListener("click", () => setMode("single"));
  $("tabProduct").addEventListener("click", () => setMode("product"));
  window.addEventListener("hashchange", () => setMode(modeOfHash(), true));

  buildGallery();
  fillFactorSelects();
  single.catalog = Math.max(0, idOf("P5"));
  single.graph = DATA[single.catalog];
  $("spec").value = specOf(single.graph, 0);
  setMode(modeOfHash(), true);
})();
</script>
</body>
</html>
