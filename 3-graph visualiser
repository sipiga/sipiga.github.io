    scene.moveSet = null;
    chipMap = [];
    scene.setContent(V, E, { r: g.n > 12 ? 11 : 14, font: g.n > 12 ? 12 : 15, hubs: true, painter });
  }
  function singleInfo() {
    const g = single.graph, L = g.layouts[single.layout];
    $("facts").innerHTML = "";
    const ne = g.edges.length;
    addFact("Size", g.n + " vertices, " + ne + (ne === 1 ? " edge" : " edges"));
    if (g.custom) {
      $("desc").textContent = "A 3‑graph you defined.";
      const t = isTripartite(g.n, g.edges);
      addFact("Tripartite", t === null ? "Not checked (more than 12 vertices)" : (t ? "Yes" : "No"));
      return;
    }
    $("desc").innerHTML = fmt(g.desc);
    let sym;
    if (L.shown === g.aut) sym = g.aut + " automorphisms, all visible as symmetries of this drawing.";
    else if (L.shown > 1) sym = g.aut + " automorphisms, " + L.shown + " of them visible as symmetries of this drawing.";
    else sym = g.aut + " automorphisms; this layout shows none of them.";
    addFact("Symmetry", sym);
    let sub;
    if (g.id === "K13" || g.id === "P3K2") sub = "Minimal: every proper subgraph is tripartite.";
    else if (g.k4m && g.f5) sub = "Contains both K₄⁻ and F₅.";
    else if (g.k4m) sub = "Contains K₄⁻ but not F₅.";
