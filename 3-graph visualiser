  function singleContent() {
    const g = single.graph, L = g.layouts[single.layout], s = R0 * single.scale;
    const V = L.pos.map((p, i) => ({ label: String(i + 1), x: W / 2 + s * p[0], y: H / 2 + s * p[1] }));
    const E = g.edges.map((e, k) => ({ v: e.map(x => x - 1), color: PALETTE[k % PALETTE.length], visible: true }));
    let axisEls = [], ghostEls = [];
    const painter = {
      build(layer) {
        layer.style.display = "";
        axisEls = (L.axes || []).map(() => { const ln = el("line", { class: "axis" }); layer.appendChild(ln); return ln; });
        ghostEls = g.ghosts.map(() => { const p = el("polygon", { class: "ghost" }); layer.appendChild(p); return p; });
      },
      update(sc) {
        // mirror axes of the stored layout, shown only while the layout is untouched
        const show = single.axes && sc.pristine, r = R0 * single.scale;
        const cx = W / 2 + r * L.centre[0], cy = H / 2 + r * L.centre[1];
        axisEls.forEach((ln, i) => {
          ln.style.display = show ? "" : "none";
          const a = L.axes[i] * Math.PI / 180, dx = Math.cos(a) * 460, dy = Math.sin(a) * 460;
          ln.setAttribute("x1", cx - dx); ln.setAttribute("y1", cy - dy); ln.setAttribute("x2", cx + dx); ln.setAttribute("y2", cy + dy);
        });
        ghostEls.forEach((p, i) => {
          p.style.display = single.ghost ? "" : "none";
          p.setAttribute("points", g.ghosts[i].map(v => sc.V[v - 1].x + "," + sc.V[v - 1].y).join(" "));
