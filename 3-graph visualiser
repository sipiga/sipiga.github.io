  const scene = new Scene($("canvas"));
  let chipMap = [];           // [{k, li}] chips in the side panel tied to edges of the scene
  scene.onRender = act => {
    for (const c of chipMap) {
      const pinned = scene.pinned.has(c.k), hot = !!(act && act.has(c.k));
      c.li.classList.toggle("pinned", pinned);
      c.li.classList.toggle("hot", hot && !pinned);
      c.li.classList.toggle("dim", !!(act && !hot));
    }
  };
  function edgeChip(k, text, title, color) {
    const li = document.createElement("li");
    li.style.setProperty("--c", color);
    const sw = document.createElement("span"); sw.className = "sw";
    li.appendChild(sw); li.appendChild(document.createTextNode(text));
    li.title = title;
    li.addEventListener("mouseenter", () => scene.setHover(k, null));
    li.addEventListener("mouseleave", () => { if (scene.hoverEdge === k) scene.setHover(null, null); });
    li.addEventListener("click", () => scene.togglePin(k));
    $("edgeList").appendChild(li);
    chipMap.push({ k, li });
