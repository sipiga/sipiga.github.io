<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>3‑graph visualiser</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Albert+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
:root {
  box-sizing: border-box;
  padding-top: env(safe-area-inset-top, 0px);
  padding-bottom: env(safe-area-inset-bottom, 0px);
  color-scheme: light;
  --bg: #f3f5f7;
  --panel: #ffffff;
  --ink: #1b2430;
  --muted: #5c6773;
  --line: #d5dbe2;
  --line-strong: #aeb8c2;
  --accent: #2f5d8a;
  --accent-ink: #ffffff;
  --accent-soft: #e4edf6;
  --vertex-fill: #ffffff;
  --vertex-stroke: #1b2430;
  --ghost: #7a8793;
  --focus: #2f5d8a;
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    color-scheme: dark;
    --bg: #121820;
    --panel: #1a2230;
    --ink: #e6ecf2;
    --muted: #93a0ad;
    --line: #2c3744;
    --line-strong: #44515f;
    --accent: #7fb3e6;
    --accent-ink: #0f1620;
    --accent-soft: #223247;
    --vertex-fill: #1a2230;
    --vertex-stroke: #e6ecf2;
    --ghost: #7a8793;
    --focus: #7fb3e6;
  }
}
:root[data-theme="dark"] {
  color-scheme: dark;
  --bg: #121820;
  --panel: #1a2230;
  --ink: #e6ecf2;
  --muted: #93a0ad;
  --line: #2c3744;
  --line-strong: #44515f;
  --accent: #7fb3e6;
  --accent-ink: #0f1620;
  --accent-soft: #223247;
  --vertex-fill: #1a2230;
  --vertex-stroke: #e6ecf2;
  --ghost: #7a8793;
  --focus: #7fb3e6;
}
html { scroll-padding-top: env(safe-area-inset-top, 0px); }
*, *::before, *::after { box-sizing: inherit; }
body {
  margin: 0;
  background: var(--bg);
  color: var(--ink);
  font-family: "Albert Sans", system-ui, -apple-system, "Segoe UI", sans-serif;
  font-size: 15px;
  line-height: 1.45;
}
header.top { max-width: 1180px; margin: 0 auto; padding: 22px 20px 12px; }
.headrow { display: flex; align-items: center; gap: 18px; flex-wrap: wrap; margin-bottom: 6px; }
h1 { font-size: 21px; font-weight: 600; margin: 0; letter-spacing: -0.01em; }
.modes { display: flex; gap: 6px; }
.modes button[aria-selected="true"] { background: var(--accent); color: var(--accent-ink); border-color: var(--accent); }
header.top p { margin: 0; color: var(--muted); max-width: 84ch; }
body[data-mode="single"] .only-product, body[data-mode="product"] .only-single { display: none !important; }
main {
  max-width: 1180px; margin: 0 auto; padding: 0 20px 40px;
  display: grid; grid-template-columns: minmax(0, 1fr) 330px; gap: 18px; align-items: start;
}
@media (max-width: 900px) {
  main { display: flex; flex-direction: column; }
  main > .col { display: contents; }
  .canvas-card { order: 1; }
  .factors { order: 2; }
  aside.col > .card { order: 3; }
  .gallery { order: 4; }
}
.col { display: grid; gap: 18px; min-width: 0; }
.card { background: var(--panel); border: 1px solid var(--line); border-radius: 10px; min-width: 0; }

/* canvas */
.canvas-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 10px 14px; border-bottom: 1px solid var(--line); }
.canvas-head .title { font-size: 17px; font-weight: 600; min-width: 0; }
.canvas-head .nav { display: flex; gap: 6px; flex: none; }
svg#canvas {
  width: 100%; height: auto; display: block;
  touch-action: none; user-select: none; -webkit-user-select: none;
  font-family: "Albert Sans", system-ui, sans-serif;
}
.hint { font-size: 12.5px; color: var(--muted); margin: 0; padding: 8px 14px 10px; border-top: 1px solid var(--line); }
.edge .blob {
  fill: var(--c); stroke: var(--c);
  fill-opacity: var(--fo); stroke-opacity: var(--so); stroke-width: var(--halo);
  stroke-linejoin: round; stroke-linecap: round;
  transition: fill-opacity .12s, stroke-opacity .12s;
}
.edge .casing { display: none; fill: none; stroke: var(--panel); stroke-width: var(--bar-case); stroke-linejoin: round; stroke-linecap: round; }
.edge.bar .casing { display: block; }
.edge.bar .blob { fill: none; stroke-width: var(--bar-w); stroke-opacity: 1; }
.edge.bar.dim .blob { stroke-opacity: 0.15; }
.edge.dim .casing, .edge[data-style="hub"] .casing { display: none; }
.edge .spoke { stroke: var(--c); stroke-width: 3.5; stroke-linecap: round; opacity: .85; }
.edge .hub { fill: var(--c); stroke: var(--panel); stroke-width: 2; }
.edge .spoke, .edge .hub { display: none; }
.edge[data-style="hub"] .spoke, .edge[data-style="hub"] .hub { display: block; }
.edge[data-style="hub"] .blob { display: none; }
.edge.hot .blob { fill-opacity: var(--fo-hot); stroke-opacity: 0.95; stroke-width: var(--halo-hot); }
.edge.dim .blob { fill-opacity: calc(var(--fo) * 0.25); stroke-opacity: var(--so-dim); }
.edge.dim .spoke, .edge.dim .hub { opacity: .18; }
.edge.hot .spoke { stroke-width: 5.5; }
.edge { cursor: pointer; }
sub, sup { font-size: 0.72em; line-height: 0; }
.ghost { fill: none; stroke: var(--ghost); stroke-width: 2; stroke-dasharray: 6 6; stroke-linejoin: round; opacity: .8; pointer-events: none; }
.axis { stroke: var(--line-strong); stroke-width: 1.2; stroke-dasharray: 2 5; pointer-events: none; }
.vertex { cursor: grab; }
.vertex.dragging, .handle.dragging { cursor: grabbing; }
.vertex circle { fill: var(--vertex-fill); stroke: var(--vertex-stroke); stroke-width: 2; }
.vertex.hovered circle, .vertex.dragging circle { stroke-width: 3.5; }
.vertex.marked circle { stroke: var(--accent); stroke-width: 3.5; }
.vertex text { fill: var(--ink); font-weight: 600; pointer-events: none; }
.nolabels .vertex text { display: none; }
.vertex:focus { outline: none; }
.vertex:focus-visible circle { stroke: var(--focus); stroke-width: 3.5; }
/* product background */
.disc { fill: var(--line); fill-opacity: .3; stroke: var(--line-strong); stroke-width: 1; stroke-dasharray: 3 4; pointer-events: none; }
.band { fill: var(--c); fill-opacity: .05; stroke: var(--c); stroke-opacity: .16; stroke-width: 24; stroke-linejoin: round; pointer-events: none; }
.band.sel { fill-opacity: .09; stroke-opacity: .34; }
.band.unsel { fill-opacity: .012; stroke-opacity: .05; }
.inner { fill: var(--c); fill-opacity: .08; stroke: var(--c); stroke-opacity: .6; stroke-width: 1.3; stroke-linejoin: round; pointer-events: none; }
.inner.sel { fill-opacity: .22; stroke-opacity: 1; stroke-width: 2.2; }
.inner.unsel { fill-opacity: .015; stroke-opacity: .16; }
.handle { cursor: grab; }
.handle rect { fill: var(--panel); stroke: var(--line-strong); stroke-width: 1.2; }
.handle text { fill: var(--muted); font-size: 12px; font-weight: 600; pointer-events: none; }
.handle:hover rect { stroke: var(--accent); }

/* gallery */
.gallery { padding: 12px 14px 14px; }
.gallery h2, .block h2, .factor h2 { margin: 0 0 8px; font-size: 13px; font-weight: 600; color: var(--muted); }
.grow { display: grid; grid-template-columns: 128px minmax(0, 1fr); gap: 8px; align-items: start; padding: 6px 0; border-top: 1px solid var(--line); }
.grow:first-of-type { border-top: 0; }
.grow .glabel { font-size: 12.5px; color: var(--muted); padding-top: 6px; }
.tiles { display: flex; flex-wrap: wrap; gap: 6px; }
.tile {
  width: 84px; padding: 4px 2px 5px; border: 1px solid transparent; border-radius: 8px;
  background: none; color: var(--ink); cursor: pointer; text-align: center;
  font: inherit; font-size: 11.5px; line-height: 1.2;
}
.tile svg { width: 62px; height: 62px; display: block; margin: 0 auto 2px; }
.tile:hover { border-color: var(--line-strong); }
.tile[aria-pressed="true"] { border-color: var(--accent); background: var(--accent-soft); }
.tile .tv { fill: var(--ink); }
.gallery .legend { font-size: 12.5px; color: var(--muted); margin: 10px 0 0; max-width: 78ch; }
@media (max-width: 560px) { .grow { grid-template-columns: 1fr; gap: 2px; } .grow .glabel { padding-top: 0; } }

/* factor panels */
.factors { padding: 12px 14px 14px; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 18px; }
@media (max-width: 680px) { .factors { grid-template-columns: minmax(0, 1fr); } }
.factor { min-width: 0; }
.factor .fhead { display: flex; align-items: center; gap: 6px; margin-bottom: 8px; }
.factor .fname { font-weight: 600; font-size: 16px; flex: none; }
.factor select.fsel { flex: 1; min-width: 0; max-width: none; }
.factor .fbody { display: grid; grid-template-columns: 148px minmax(0, 1fr); gap: 10px; align-items: start; }
.factor .fside { display: grid; gap: 8px; }
.fmini { width: 148px; height: 148px; display: block; font-family: "Albert Sans", system-ui, sans-serif; }
.fmini .medge { cursor: pointer; fill: var(--c); stroke: var(--c); fill-opacity: .2; stroke-opacity: .7; stroke-width: 5; stroke-linejoin: round; }
.fmini .medge.bar { fill: none; stroke-opacity: 1; stroke-width: 8; }
.fmini .medge.sel { fill-opacity: .5; stroke-opacity: 1; stroke-width: 7; }
.fmini .medge.unsel { fill-opacity: .03; stroke-opacity: .15; }
.fmini .medge.bar.unsel { stroke-opacity: .2; }
.fmini .mv { cursor: default; }
.fmini .mv circle { fill: var(--vertex-fill); stroke: var(--vertex-stroke); stroke-width: 3; }
.fmini .mv:hover circle { stroke: var(--accent); stroke-width: 5; }
.fmini .mv text { fill: var(--ink); font-size: 21px; font-weight: 600; pointer-events: none; }
.fnote { font-size: 12.5px; color: var(--muted); margin: 0; }
button.icon { padding: 5px 9px; line-height: 1; }

/* side panel */
.block { padding: 14px 16px; }
.desc { margin: 0 0 10px; }
dl.facts { margin: 0; display: grid; gap: 6px; font-size: 13.5px; }
dl.facts div { display: grid; grid-template-columns: 96px minmax(0, 1fr); gap: 8px; }
dl.facts dt { color: var(--muted); }
dl.facts dd { margin: 0; }
ul.edges { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; }
ul.edges li {
  display: inline-flex; align-items: center; gap: 7px;
  padding: 4px 9px 4px 7px; border: 1px solid var(--line); border-radius: 999px;
  font-family: "JetBrains Mono", ui-monospace, Menlo, monospace; font-size: 13px;
  cursor: pointer; transition: border-color .12s, opacity .12s; white-space: nowrap;
}
ul.edges li .sw { width: 11px; height: 11px; border-radius: 50%; background: var(--c); flex: none; }
ul.edges li:hover, ul.edges li.hot { border-color: var(--c); }
ul.edges li.pinned { background: var(--c); color: #fff; border-color: var(--c); }
ul.edges li.pinned .sw { background: #fff; }
ul.edges li.dim { opacity: .35; }
ul.edges li.ghostli { border-style: dashed; color: var(--muted); cursor: default; }
ul.edges li.ghostli .sw { background: none; border: 1.5px dashed var(--ghost); }
.note { font-size: 13px; color: var(--muted); margin: 0; }
.note:empty { display: none; }
.controls { display: grid; gap: 10px; }
.row { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
.checks { display: grid; grid-template-columns: 1fr 1fr; gap: 6px 10px; }
input[type="range"] { width: 140px; accent-color: var(--accent); }
input[type="checkbox"] { accent-color: var(--accent); }
select, button, textarea {
  font: inherit; color: var(--ink); background: var(--panel);
  border: 1px solid var(--line-strong); border-radius: 7px;
}
select { padding: 5px 8px; max-width: 200px; }
button { padding: 6px 12px; cursor: pointer; }
button:hover { border-color: var(--accent); }
button.primary { background: var(--accent); color: var(--accent-ink); border-color: var(--accent); }
button:focus-visible, select:focus-visible, textarea:focus-visible, input:focus-visible, summary:focus-visible, .tile:focus-visible {
  outline: 2px solid var(--focus); outline-offset: 2px;
}
.btns { display: flex; gap: 8px; flex-wrap: wrap; }
details summary { cursor: pointer; font-size: 13px; font-weight: 600; color: var(--muted); }
details[open] summary { margin-bottom: 10px; }
textarea {
  width: 100%; min-height: 132px; resize: vertical; padding: 8px 10px;
  font-family: "JetBrains Mono", ui-monospace, Menlo, monospace; font-size: 12.5px; line-height: 1.5;
}
.help { font-size: 12.5px; color: var(--muted); margin: 6px 0 8px; }
.help code { font-family: "JetBrains Mono", ui-monospace, monospace; font-size: 12px; }
.err { color: #c0392b; font-size: 13px; margin: 0 0 8px; white-space: pre-line; }
.err:empty { display: none; }
@media (prefers-reduced-motion: reduce) { * { transition: none !important; } }
</style>
</head>
<body data-mode="single">
<header class="top">
  <div class="headrow">
    <h1>3‑graph visualiser</h1>
    <div class="modes" role="tablist" aria-label="View">
      <button id="tabSingle" role="tab" aria-selected="true">Single 3‑graphs</button>
      <button id="tabProduct" role="tab" aria-selected="false">Cross products</button>
    </div>
  </div>
  <p class="only-single">The 27 non‑tripartite 3‑graphs on at most five vertices, each drawn with as much of its symmetry visible as the plane allows. Drag vertices to rearrange; hover a vertex or an edge to highlight, click an edge to pin it.</p>
  <p class="only-product">The cross product H × F, drawn as one factor blown up into clusters with the other factor repeated inside each cluster. Choose the two factors below the drawing, then pick an edge of each to see the six product edges between them.</p>
</header>
<main>
  <div class="col">
    <section class="card canvas-card">
      <div class="canvas-head">
        <div class="title" id="title"></div>
        <div class="nav only-single">
          <button id="prev" aria-label="Previous 3-graph">Previous</button>
          <button id="next" aria-label="Next 3-graph">Next</button>
        </div>
      </div>
      <svg id="canvas" viewBox="0 0 640 640" aria-label="Drawing">
        <g id="back"></g>
        <g id="edges"></g>
        <g id="handles"></g>
        <g id="vertices"></g>
      </svg>
      <p class="hint only-product">Drag a vertex, or a badge to move its whole cluster. Shift‑drag also moves the cluster; Alt‑drag moves the corresponding vertex of every cluster.</p>
    </section>

    <section class="card factors only-product">
      <div class="factor" id="facH">
        <div class="fhead">
          <span class="fname">H</span>
          <select class="fsel" id="facH_sel" aria-label="Factor H"></select>
          <button class="icon" id="facH_prev" aria-label="Previous choice for H">‹</button>
          <button class="icon" id="facH_next" aria-label="Next choice for H">›</button>
        </div>
        <div class="fbody">
          <svg class="fmini" id="facH_mini" viewBox="-150 -150 300 300" aria-label="Drawing of H"></svg>
          <div class="fside">
            <ul class="edges" id="facH_chips"></ul>
            <p class="fnote" id="facH_note"></p>
            <select id="facH_layout" aria-label="Layout of H"></select>
          </div>
        </div>
      </div>
      <div class="factor" id="facF">
        <div class="fhead">
          <span class="fname">F</span>
          <select class="fsel" id="facF_sel" aria-label="Factor F"></select>
          <button class="icon" id="facF_prev" aria-label="Previous choice for F">‹</button>
          <button class="icon" id="facF_next" aria-label="Next choice for F">›</button>
        </div>
        <div class="fbody">
          <svg class="fmini" id="facF_mini" viewBox="-150 -150 300 300" aria-label="Drawing of F"></svg>
          <div class="fside">
            <ul class="edges" id="facF_chips"></ul>
            <p class="fnote" id="facF_note"></p>
            <select id="facF_layout" aria-label="Layout of F"></select>
          </div>
        </div>
      </div>
    </section>

    <section class="card gallery only-single">
      <h2>Catalogue</h2>
      <div id="gallery"></div>
      <p class="legend">H(G) is the 3‑graph on five vertices whose edges are the complements of the edges of the graph G. cone(G) has a new vertex joined to every edge of G. K₅ ∖ X is the complete 3‑graph K₅⁽³⁾ with a copy of X removed.</p>
    </section>
  </div>

  <aside class="col">
    <div class="card block">
      <p class="desc" id="desc"></p>
      <dl class="facts" id="facts"></dl>
    </div>

    <div class="card block">
      <h2 id="edgesTitle">Edges</h2>
      <ul class="edges" id="edgeList"></ul>
      <p class="note" id="edgeNote"></p>
    </div>

    <div class="card block controls only-single">
      <div class="row"><label for="layout">Layout</label><select id="layout"></select></div>
      <div class="row">
        <label for="style">Edge style</label>
        <select id="style">
          <option value="blob">Rounded triangles</option>
          <option value="hub">Hub and spokes</option>
        </select>
      </div>
      <div class="row"><label for="fill">Fill</label><input type="range" id="fill" min="0" max="0.6" step="0.02" value="0.22"></div>
      <div class="row"><label for="halo">Halo width</label><input type="range" id="halo" min="0" max="40" step="1" value="14"></div>
      <div class="row"><label for="scale">Size</label><input type="range" id="scale" min="0.4" max="1.25" step="0.05" value="1"></div>
      <div class="checks">
        <label><input type="checkbox" id="labels" checked> Vertex labels</label>
        <label><input type="checkbox" id="showAxes" checked> Mirror axes</label>
        <label><input type="checkbox" id="ghost" checked> Removed edges</label>
      </div>
      <div class="btns">
        <button id="reset">Reset layout</button>
        <button id="unpin">Unpin all</button>
      </div>
    </div>

    <div class="card block controls only-product">
      <div class="row">
        <label for="pNest">Clusters</label>
        <select id="pNest">
          <option value="H">Vertices of H</option>
          <option value="F">Vertices of F</option>
        </select>
      </div>
      <div class="row">
        <label for="pColour">Colour by</label>
        <select id="pColour">
          <option value="auto">Automatic</option>
          <option value="H">Edge of H</option>
          <option value="F">Edge of F</option>
          <option value="match">Matching</option>
        </select>
      </div>
      <div class="row"><label for="pFill">Fill</label><input type="range" id="pFill" min="0" max="3" step="0.1" value="1"></div>
      <div class="row"><label for="pLine">Line width</label><input type="range" id="pLine" min="0.3" max="3" step="0.1" value="1"></div>
      <div class="row"><label for="pSize">Size</label><input type="range" id="pSize" min="0.6" max="1" step="0.02" value="1"></div>
      <div class="row"><label for="pCluster">Cluster size</label><input type="range" id="pCluster" min="0.5" max="1.5" step="0.05" value="1"></div>
      <div class="checks">
        <label><input type="checkbox" id="pLabels" checked> Vertex labels</label>
        <label><input type="checkbox" id="pBack" checked> Factors behind</label>
      </div>
      <div class="btns">
        <button id="pReset">Reset layout</button>
        <button id="pUnpin">Unpin all</button>
        <button id="pAll">Show all edges</button>
      </div>
    </div>

    <div class="card block only-single">
      <details id="defineBox">
        <summary>Define your own 3‑graph</summary>
        <textarea id="spec" spellcheck="false"></textarea>
        <p class="help">Vertices are 1…n. Write each edge as <code>123</code> (n ≤ 9) or <code>1,2,3</code>. Edges after <code>ghost:</code> are drawn dashed. <code>pos:</code> gives coordinates (x to the right, y downwards, the default circle has radius 1).</p>
        <p class="err" id="err"></p>
        <div class="btns">
          <button class="primary" id="load">Draw this 3‑graph</button>
          <button id="copyPos">Write current positions</button>
        </div>
      </details>
    </div>
  </aside>
</main>

<script>
