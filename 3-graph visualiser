  /* ================= View 1: single 3-graphs ================= */
  const single = { graph: null, layout: 0, catalog: 0, scale: 1, axes: true, ghost: true, fill: 0.22, halo: 14, style: "blob", labels: true };

  function specOf(g, li) {
    const L = g.layouts[li];
    let s = "name: " + g.name + "\nn: " + g.n + "\nedges: " + g.edges.map(e => edgeText(e, g.n)).join(" ");
    if (g.ghosts.length) s += "\nghost: " + g.ghosts.map(e => edgeText(e, g.n)).join(" ");
    s += "\npos: " + L.pos.map((p, i) => (i + 1) + " " + p[0] + " " + p[1]).join("; ");
    return s;
  }
  function parseSpec(text) {
    const g = { name: "Custom 3‑graph", n: 0, edges: [], ghosts: [], custom: true };
    const errors = [], rawEdges = [], rawGhosts = [], posMap = {};
    for (const raw of text.split("\n")) {
      const line = raw.trim();
      if (!line) continue;
      const m = line.match(/^([A-Za-z]+)\s*:\s*(.*)$/);
      if (!m) { errors.push("Cannot read the line “" + line + "”."); continue; }
      const key = m[1].toLowerCase(), val = m[2].trim();
      if (key === "name") g.name = val;
      else if (key === "n") g.n = parseInt(val, 10);
      else if (key === "edges" || key === "edge") rawEdges.push(...val.split(/[\s;]+/).filter(Boolean));
      else if (key === "ghost" || key === "ghosts") rawGhosts.push(...val.split(/[\s;]+/).filter(Boolean));
      else if (key === "pos") {
        for (const chunk of val.split(";")) {
          const t = chunk.trim().split(/[\s,]+/).filter(Boolean);
          if (t.length === 3 && t.every(x => !isNaN(parseFloat(x)))) posMap[parseInt(t[0], 10)] = [parseFloat(t[1]), parseFloat(t[2])];
          else if (chunk.trim()) errors.push("Cannot read the position “" + chunk.trim() + "”. Write: vertex x y.");
        }
      } else errors.push("Unknown field “" + key + "”.");
    }
    if (!(g.n >= 3 && g.n <= 40)) errors.push("n must be between 3 and 40.");
    const parseEdge = tok => {
      let vs;
      if (/^\d+$/.test(tok) && g.n <= 9) vs = tok.split("").map(Number);
      else vs = tok.split(/[^0-9]+/).filter(Boolean).map(Number);
      if (vs.length !== 3 || new Set(vs).size !== 3) return null;
      if (vs.some(v => v < 1 || v > g.n)) return null;
      return vs.sort((a, b) => a - b);
    };
    const uniq = arr => { const seen = new Set(); return arr.filter(e => { const k = e.join(","); if (seen.has(k)) return false; seen.add(k); return true; }); };
    for (const tok of rawEdges) { const e = parseEdge(tok); if (e) g.edges.push(e); else errors.push("“" + tok + "” is not an edge on 1…" + g.n + "."); }
    for (const tok of rawGhosts) { const e = parseEdge(tok); if (e) g.ghosts.push(e); else errors.push("“" + tok + "” is not an edge on 1…" + g.n + "."); }
    g.edges = uniq(g.edges); g.ghosts = uniq(g.ghosts);
    if (!errors.length) {
      const pos = circle(g.n);
      for (const v in posMap) if (v >= 1 && v <= g.n) pos[v - 1] = posMap[v];
      g.layouts = [{ name: Object.keys(posMap).length ? "As written" : "Circle", pos, axes: [], centre: [0, 0], shown: null }];
    }
    return { g, errors };
  }

  function thumb(g) {
    const L = g.layouts[0];
    const s = el("svg", { viewBox: "-1.28 -1.28 2.56 2.56", "aria-hidden": "true" });
    const bars = [];
    g.edges.forEach((e, i) => {
      const pts = e.map(v => L.pos[v - 1]);
      const a = Math.abs((pts[1][0] - pts[0][0]) * (pts[2][1] - pts[0][1]) - (pts[1][1] - pts[0][1]) * (pts[2][0] - pts[0][0]));
      const col = PALETTE[i % PALETTE.length], points = pts.map(p => p[0] + "," + p[1]).join(" ");
      if (a < 0.01) { bars.push(el("polygon", { points, fill: "none", stroke: col, "stroke-width": 0.12, "stroke-linejoin": "round" })); return; }
      s.appendChild(el("polygon", { points, fill: col, "fill-opacity": 0.24, stroke: col, "stroke-opacity": 0.75, "stroke-width": 0.06, "stroke-linejoin": "round" }));
    });
    bars.forEach(b => s.appendChild(b));
    L.pos.forEach(p => s.appendChild(el("circle", { cx: p[0], cy: p[1], r: 0.1, class: "tv" })));
    return s;
  }
  function buildGallery() {
    const box = $("gallery"), groups = [];
    DATA.forEach((g, i) => {
      const key = g.n === 4 ? "4 vertices" : g.edges.length + " edges";
      let grp = groups.find(x => x.key === key);
      if (!grp) { grp = { key, items: [] }; groups.push(grp); }
      grp.items.push(i);
    });
    let first5 = true;
    for (const grp of groups) {
      const row = document.createElement("div"); row.className = "grow";
      const lab = document.createElement("div"); lab.className = "glabel";
      if (grp.key === "4 vertices") lab.textContent = "4 vertices";
      else { lab.textContent = (first5 ? "5 vertices, " : "") + grp.key; first5 = false; }
      const tiles = document.createElement("div"); tiles.className = "tiles";
      for (const i of grp.items) {
        const b = document.createElement("button");
        b.className = "tile"; b.type = "button"; b.dataset.index = i;
        b.setAttribute("aria-pressed", "false");
        b.title = DATA[i].name;
        b.appendChild(thumb(DATA[i]));
        const sp = document.createElement("span"); sp.innerHTML = fmt(DATA[i].short); b.appendChild(sp);
        b.addEventListener("click", () => selectCatalog(i));
